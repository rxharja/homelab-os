# /etc/homelab/homelab.env  (non-secret machine config)
DOMAIN=katieredihouse.com
# Give the mini PC a DHCP reservation on your router and put it here.
LAN_IP=192.168.1.50
ACME_EMAIL=you@example.com
TZ=America/New_York

# Open WebUI's public URL; keep the domain in sync with DOMAIN.
WEBUI_URL=https://chat.katieredihouse.com

# Tailnet node name and the host field on restic snapshots. NOT the OS
# hostname: that's /etc/hostname, shipped as "homelab" by the image.
# TS_ADVERTISE_ROUTES is an optional subnet route to reach the whole LAN remotely.
TS_HOSTNAME=homelab
#TS_ADVERTISE_ROUTES=192.168.1.0/24

# Sized for the 680M + 24GB shared RAM. Pulled automatically after Ollama starts.
OLLAMA_MODELS="qwen3:8b qwen3:4b"

# Override Riven's plugin list (JSON array, no spaces).
#RIVEN_PLUGINS=["seerr","stremthru","torrentio","comet","jellyfin"]
