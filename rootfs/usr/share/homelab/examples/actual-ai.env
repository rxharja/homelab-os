# /etc/homelab/actual-ai.env  (chmod 600). actual-ai.service is skipped until this exists.
# Podman env-file format: no quotes around values, they'd be kept literally.
ACTUAL_PASSWORD=       # Actual server password
ACTUAL_BUDGET_ID=      # Actual > Settings > Show advanced settings > Sync ID
#ACTUAL_E2E_PASSWORD=  # only if the budget has end-to-end encryption

# dryRun only logs its picks: check `journalctl -u actual-ai`, then drop it and restart.
# Never add suggestNewCategories: it lets the model create categories.
FEATURES=["classifyOnStartup","syncAccountsBeforeClassify","dryRun"]
