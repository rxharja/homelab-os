# /etc/homelab/actual-ai.env  (chmod 600). actual-ai.service is skipped until this exists.
# Podman env-file format: no quotes, and no trailing comments; both end up in the value.
# The server password goes in secrets.env as ACTUAL_PASSWORD (a podman secret, not env).

# Actual > Settings > Show advanced settings > Sync ID
ACTUAL_BUDGET_ID=

# Only if the budget has end-to-end encryption.
#ACTUAL_E2E_PASSWORD=

# dryRun only logs its picks: check `journalctl -u actual-ai`, then drop it and restart.
# Never add suggestNewCategories: it lets the model create categories.
FEATURES=["classifyOnStartup","syncAccountsBeforeClassify","dryRun"]
