# /etc/homelab/secrets.env  (chmod 600, never commit, never bake into the image)
CF_API_TOKEN=          # Cloudflare token: Zone.DNS:Edit on your domain
RD_TOKEN=              # real-debrid.com/apitoken
TMDB_API_KEY=          # TMDB "API Read Access Token"
RIVEN_DB_PASSWORD=     # openssl rand -hex 24
PAPERLESS_DB_PASSWORD= # openssl rand -hex 24
PAPERLESS_SECRET_KEY=  # openssl rand -base64 32
POCKET_ID_ENCRYPTION_KEY= # openssl rand -base64 32. Losing it locks out every login.

# Created in the apps after first boot, then: sudo systemctl restart homelab-render riven paperless-gpt actual-ai open-webui tinyauth paperless
SEERR_API_KEY=         # Seerr > Settings > General
JELLYFIN_API_KEY=      # Jellyfin > Dashboard > API Keys
PAPERLESS_API_TOKEN=   # Paperless > My Profile > API Auth Token
ACTUAL_PASSWORD=       # Actual's server password, for actual-ai
# Pocket ID > OIDC Clients > Open WebUI (callback https://chat.DOMAIN/oauth/oidc/callback)
OPEN_WEBUI_OIDC_CLIENT_ID=
OPEN_WEBUI_OIDC_CLIENT_SECRET=
# Pocket ID > OIDC Clients > Tinyauth (callback https://auth.DOMAIN/api/oauth/callback/pocketid)
TINYAUTH_OIDC_CLIENT_ID=
TINYAUTH_OIDC_CLIENT_SECRET=
# Pocket ID > OIDC Clients > Paperless (callback https://docs.DOMAIN/accounts/oidc/pocketid/login/callback/)
PAPERLESS_OIDC_CLIENT_ID=
PAPERLESS_OIDC_CLIENT_SECRET=

# Tailscale: one-off, pre-approved auth key (tag:server recommended)
TS_AUTHKEY=

# Restic: e.g. sftp:user@nas:/backups/homelab or b2:bucket:homelab (+ B2_ACCOUNT_ID/KEY)
RESTIC_REPOSITORY=
RESTIC_PASSWORD=       # store a copy in your password manager. No password = no restore.
