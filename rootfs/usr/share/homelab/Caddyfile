# {$DOMAIN} and {$ACME_EMAIL} come from /etc/homelab/homelab.env, loaded by
# caddy.container. Wildcard cert via Cloudflare DNS-01, so no inbound ports.
# Cockpit is not proxied; it lives at https://LAN_IP:9090.
{
	email {$ACME_EMAIL}
}

*.{$DOMAIN}, {$DOMAIN} {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1 9.9.9.9
	}

	@root host {$DOMAIN}
	handle @root {
		redir https://jellyfin.{$DOMAIN}{uri}
	}

	@adguard host adguard.{$DOMAIN}
	handle @adguard {
		reverse_proxy adguard:3000
	}

	@jellyfin host jellyfin.{$DOMAIN}
	handle @jellyfin {
		reverse_proxy jellyfin:8096
	}

	@seerr host seerr.{$DOMAIN}
	handle @seerr {
		reverse_proxy seerr:5055
	}

	@chat host chat.{$DOMAIN}
	handle @chat {
		reverse_proxy open-webui:8080
	}

	@paperless host docs.{$DOMAIN}
	handle @paperless {
		reverse_proxy paperless:8000
	}

	handle {
		respond "Not found" 404
	}
}
