# {$DOMAIN} and {$ACME_EMAIL} come from /etc/homelab/homelab.env, loaded by
# caddy.container. Wildcard cert via Cloudflare DNS-01, so no inbound ports.
# Cockpit is not proxied; it lives at https://LAN_IP:9090.
{
	email {$ACME_EMAIL}
}

# Pocket ID login (via Tinyauth) for apps without their own. Fails closed: if Tinyauth
# is down or unconfigured, the route errors instead of opening up.
(pocketid_gate) {
	forward_auth tinyauth:3000 {
		uri /api/auth/caddy
		copy_headers Remote-User Remote-Email Remote-Groups
	}
}

*.{$DOMAIN}, {$DOMAIN} {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1 9.9.9.9
	}

	@root host {$DOMAIN}
	handle @root {
		redir https://jellyfin.{$DOMAIN}{uri}
	}

	@adguard host adguard.{$DOMAIN}
	handle @adguard {
		import pocketid_gate
		reverse_proxy adguard:3000
	}

	@jellyfin host jellyfin.{$DOMAIN}
	handle @jellyfin {
		reverse_proxy jellyfin:8096
	}

	@seerr host seerr.{$DOMAIN}
	handle @seerr {
		reverse_proxy seerr:5055
	}

	@chat host chat.{$DOMAIN}
	handle @chat {
		reverse_proxy open-webui:8080
	}

	@paperless host docs.{$DOMAIN}
	handle @paperless {
		reverse_proxy paperless:8000
	}

	@sort host sort.{$DOMAIN}
	handle @sort {
		import pocketid_gate
		reverse_proxy paperless-gpt:8080
	}

	@budget host budget.{$DOMAIN}
	handle @budget {
		reverse_proxy actual:5006
	}

	@auth host auth.{$DOMAIN}
	handle @auth {
		reverse_proxy tinyauth:3000
	}

	@id host id.{$DOMAIN}
	handle @id {
		reverse_proxy pocket-id:1411
	}

	handle {
		respond "Not found" 404
	}
}
