# Rendered to /var/lib/homelab/config/tinyauth/tinyauth.env (mode 600).
# Podman env-file format: no quotes, no trailing comments.
# Tinyauth doesn't read discovery, so Pocket ID's endpoints are spelled out.
TINYAUTH_APPURL=https://auth.${DOMAIN}
TINYAUTH_OAUTH_PROVIDERS_POCKETID_CLIENTID=${TINYAUTH_OIDC_CLIENT_ID}
TINYAUTH_OAUTH_PROVIDERS_POCKETID_CLIENTSECRET=${TINYAUTH_OIDC_CLIENT_SECRET}
TINYAUTH_OAUTH_PROVIDERS_POCKETID_AUTHURL=https://id.${DOMAIN}/authorize
TINYAUTH_OAUTH_PROVIDERS_POCKETID_TOKENURL=https://id.${DOMAIN}/api/oidc/token
TINYAUTH_OAUTH_PROVIDERS_POCKETID_USERINFOURL=https://id.${DOMAIN}/api/oidc/userinfo
