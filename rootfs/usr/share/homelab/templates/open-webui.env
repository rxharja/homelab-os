# Rendered to /var/lib/homelab/config/open-webui/open-webui.env (mode 600).
# Podman env-file format: no quotes, no trailing comments.
# Empty client ID = no SSO button; Open WebUI keeps its own login either way.
OAUTH_CLIENT_ID=${OPEN_WEBUI_OIDC_CLIENT_ID}
OAUTH_CLIENT_SECRET=${OPEN_WEBUI_OIDC_CLIENT_SECRET}
OPENID_PROVIDER_URL=https://id.${DOMAIN}/.well-known/openid-configuration
# Explicit, or it's derived from the proxied request and comes out http://.
OPENID_REDIRECT_URI=https://chat.${DOMAIN}/oauth/oidc/callback
