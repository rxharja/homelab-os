# Rendered to /var/lib/homelab/config/riven/riven.env (mode 600).
# Podman env-file format: no quotes around values, they'd be kept literally.
RIVEN_SETTING__databaseUrl=postgresql+psycopg2://riven:${RIVEN_DB_PASSWORD}@riven-db:5432/riven
RIVEN_SETTING__redisUrl=redis://riven-redis:6379
RIVEN_SETTING__vfsMountPath=/mount
RIVEN_SETTING__host=0.0.0.0
RIVEN_SETTING__rankingConfigPath=/app/data/ranking.json
RIVEN_SETTING__preferSeasonPacks=true
RIVEN_SETTING__attemptUnknownDownloads=true
RIVEN_SETTING__logLevel=info
RIVEN_SETTING__enabledPlugins=${RIVEN_PLUGINS}
SENTRY_SPOTLIGHT=0

RIVEN_PLUGIN_SETTING__REPO_PLUGIN_TMDB__apiKey=${TMDB_API_KEY}
RIVEN_PLUGIN_SETTING__REPO_PLUGIN_STREMTHRU__realdebridApiKey=${RD_TOKEN}

RIVEN_PLUGIN_SETTING__REPO_PLUGIN_SEERR__url=http://seerr:5055
RIVEN_PLUGIN_SETTING__REPO_PLUGIN_SEERR__apiKey=${SEERR_API_KEY}
RIVEN_PLUGIN_SETTING__REPO_PLUGIN_SEERR__autofixMetadataProviders=true

RIVEN_PLUGIN_SETTING__REPO_PLUGIN_JELLYFIN__jellyfinServerUrl=http://jellyfin:8096/
RIVEN_PLUGIN_SETTING__REPO_PLUGIN_JELLYFIN__jellyfinToken=${JELLYFIN_API_KEY}
# Path as Jellyfin sees it: its container mounts /var/mnt/media at /media.
RIVEN_PLUGIN_SETTING__REPO_PLUGIN_JELLYFIN__jellyfinLibraryPath=/media/riven

# /etc/homelab/riven.extra.env is appended verbatim below this line. Put the
# Comet settings from the dev box's .env.riven there.
