# Forward-auth gate for apps with no login of their own (paperless-gpt, AdGuard).
# Caddy asks it before proxying; it signs users in through Pocket ID.
[Unit]
Description=Tinyauth (Pocket ID login in front of Caddy routes)
Requires=homelab-render.service
After=homelab-render.service pocket-id.service

[Container]
Image=ghcr.io/tinyauthapp/tinyauth:v5
AutoUpdate=registry
ContainerName=tinyauth
Network=homelab.network
UserNS=auto
# APPURL, Pocket ID client and endpoint URLs, rendered by homelab-render.
EnvironmentFile=/var/lib/homelab/config/tinyauth/tinyauth.env
Environment="TINYAUTH_OAUTH_PROVIDERS_POCKETID_NAME=Pocket ID"
Environment=TINYAUTH_OAUTH_PROVIDERS_POCKETID_SCOPES=openid,email,profile,groups
# Straight to Pocket ID; there are no local Tinyauth users.
Environment=TINYAUTH_OAUTH_AUTOREDIRECT=pocketid
Environment=TINYAUTH_AUTH_SECURECOOKIE=true
Environment=TINYAUTH_ANALYTICS_ENABLED=false
# No docker socket: per-app rules would come from env, not container labels.
Environment=TINYAUTH_LABELPROVIDER=none
Volume=/var/lib/homelab/appdata/tinyauth:/data:Z,U

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
