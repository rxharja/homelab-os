# ROCm on the Radeon 680M (gfx1035). HSA_OVERRIDE_GFX_VERSION makes ROCm treat
# it as a supported RDNA2 part. VERIFY ON HARDWARE; if ROCm won't take the iGPU,
# see the llama.cpp Vulkan fallback in docs/operations.md.
[Unit]
Description=Ollama (local LLM)
After=homelab-render.service
Requires=homelab-render.service

[Container]
Image=docker.io/ollama/ollama:rocm
AutoUpdate=registry
ContainerName=ollama
Network=homelab.network
# No "-" prefix: quadlet checks it at generator time, before amdgpu creates the nodes.
AddDevice=/dev/dri
AddDevice=/dev/kfd
SecurityLabelDisable=true
Environment=HSA_OVERRIDE_GFX_VERSION=10.3.0
# Ollama skips integrated GPUs unless told otherwise.
Environment=OLLAMA_IGPU_ENABLE=1
Environment=OLLAMA_KEEP_ALIVE=30m
# LAN-exposed WITHOUT auth so Neptune can use it. Never port-forward this.
PublishPort=11434:11434
Volume=/var/lib/homelab/appdata/ollama:/root/.ollama

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
