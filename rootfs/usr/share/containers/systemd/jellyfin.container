# Jellyfin reads /var/mnt/media (riven/ + zurg/) via rslave, so it follows
# Riven/rclone remounts live without restarting. No user namespace: reading
# root-owned FUSE mounts across a userns is unreliable.
[Unit]
Description=Jellyfin
Requires=homelab-render.service
Wants=riven.service zurg-mount.service
After=homelab-render.service homelab-media-mount.service riven.service zurg-mount.service

[Container]
Image=docker.io/jellyfin/jellyfin:latest
AutoUpdate=registry
ContainerName=jellyfin
Network=homelab.network
SecurityLabelDisable=true
# "-" = optional, so the unit still starts in a VM with no GPU.
AddDevice=-/dev/dri
AddDevice=-/dev/kfd
# Direct LAN access for apps that want ip:port (Neptune, Infuse). Caddy also proxies it.
PublishPort=8096:8096
Volume=/var/lib/homelab/appdata/jellyfin/config:/config
Volume=/var/lib/homelab/appdata/jellyfin/cache:/cache
Volume=/var/mnt/media:/media:ro,rslave

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
