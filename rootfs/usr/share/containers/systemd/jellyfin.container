# rslave on /var/mnt/media makes Riven/rclone remounts visible without a
# restart. No user namespace: reading root-owned FUSE mounts across one is
# unreliable.
[Unit]
Description=Jellyfin
Requires=homelab-render.service
Wants=riven.service
After=homelab-render.service homelab-media-mount.service riven.service

[Container]
Image=docker.io/jellyfin/jellyfin:latest
AutoUpdate=registry
ContainerName=jellyfin
Network=homelab.network
SecurityLabelDisable=true
# "-": optional, so this starts in a VM with no GPU.
AddDevice=-/dev/dri
AddDevice=-/dev/kfd
# Direct LAN access for ip:port clients (Neptune, Infuse). Caddy also proxies it.
PublishPort=8096:8096
Volume=/var/lib/homelab/appdata/jellyfin/config:/config
Volume=/var/lib/homelab/appdata/jellyfin/cache:/cache
Volume=/var/mnt/media:/media:ro,rslave

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
