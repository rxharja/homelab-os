# Nightly LLM categorization of uncategorized Actual transactions on the shared Ollama model.
# Skipped until /etc/homelab/actual-ai.env exists (password, budget ID, FEATURES).
[Unit]
Description=actual-ai (LLM transaction categorization for Actual)
ConditionPathExists=/etc/homelab/actual-ai.env
After=actual.service ollama.service
Wants=actual.service ollama.service

[Container]
Image=docker.io/sakowicz/actual-ai:latest
AutoUpdate=registry
ContainerName=actual-ai
Network=homelab.network
UserNS=auto
EnvironmentFile=/etc/homelab/actual-ai.env
Environment=ACTUAL_SERVER_URL=http://actual:5006
Environment=LLM_PROVIDER=ollama
Environment=OLLAMA_BASE_URL=http://ollama:11434/api
# Same model as everything else, so Ollama keeps a single runner loaded.
Environment=OLLAMA_MODEL=qwen3-vl:8b-instruct
# 02:00, clear of the 03:30 backup that stops Actual.
Environment=CLASSIFICATION_SCHEDULE_CRON=0 2 * * *

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
