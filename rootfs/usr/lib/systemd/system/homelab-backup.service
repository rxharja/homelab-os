[Unit]
Description=Restic backup of homelab state
Wants=network-online.target
After=network-online.target riven-db.service
ConditionPathExists=/etc/homelab/secrets.env

[Service]
Type=oneshot
ExecStart=/usr/bin/homelab-backup
# System units get no $HOME, and restic exits without a cache dir.
CacheDirectory=restic
Environment=RESTIC_CACHE_DIR=%C/restic
Nice=10
IOSchedulingClass=idle
