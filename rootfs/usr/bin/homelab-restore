#!/usr/bin/bash
# Restore app state from restic onto a freshly installed box.
#   sudo homelab-restore [snapshot-id]   (default: latest)
# Prereq: /etc/homelab/secrets.env holds RESTIC_REPOSITORY + RESTIC_PASSWORD.
set -euo pipefail
SNAP=${1:-latest}
set -a; . /etc/homelab/secrets.env; set +a
APP=/var/lib/homelab/appdata
SERVICES=(caddy pocket-id actual-ai actual open-webui seerr jellyfin riven zurg-mount zurg riven-redis riven-db adguard paperless-gpt paperless paperless-db paperless-redis)

read -rp "This overwrites $APP with snapshot '$SNAP'. Type yes: " ok
[[ $ok == yes ]] || exit 1

systemctl stop "${SERVICES[@]/%/.service}" || true
# /etc/homelab from the snapshot goes aside for comparison; your current one stays.
restic restore "$SNAP" --target /var/tmp/homelab-restore --include /etc/homelab
restic restore "$SNAP" --target / --include "$APP"
echo "Snapshot's /etc/homelab is in /var/tmp/homelab-restore/etc/homelab (diff it against yours)."

# Pocket ID's data is encrypted with this key; a fresh secrets.env would lock everyone out.
snap_key=$(set +u; . /var/tmp/homelab-restore/etc/homelab/secrets.env 2>/dev/null; echo "${POCKET_ID_ENCRYPTION_KEY:-}")
cur_key=$(set +u; . /etc/homelab/secrets.env; echo "${POCKET_ID_ENCRYPTION_KEY:-}")
if [[ -n $snap_key && $snap_key != "$cur_key" ]]; then
  echo "POCKET_ID_ENCRYPTION_KEY differs from the snapshot's. Copy it from" >&2
  echo "/var/tmp/homelab-restore/etc/homelab/secrets.env, then re-run. Services left stopped." >&2
  exit 1
fi

# Snapshots older than an app have no dump for it; that app starts empty.
for db in riven paperless; do
  if [[ -r $APP/_dumps/$db.sql ]]; then
    homelab-load-db "$db" "$APP/_dumps/$db.sql"
  else
    echo "WARNING: no $db.sql in snapshot; $db-db starts empty"
  fi
done
systemctl start homelab-render.service
systemctl start "${SERVICES[@]/%/.service}"
echo "restore complete"
