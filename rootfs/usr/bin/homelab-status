#!/usr/bin/bash
# Quick health view.
units=(homelab-render homelab-media-mount adguard caddy riven-db riven-redis riven jellyfin seerr ollama open-webui paperless paperless-redis paperless-db paperless-gpt actual tailscaled)
printf '%-22s %s\n' UNIT STATE
for u in "${units[@]}"; do printf '%-22s %s\n' "$u" "$(systemctl is-active "$u.service" 2>/dev/null)"; done
echo
# findmnt takes one path: more are read as device + mountpoint and match nothing.
echo "mounts:"
for m in /var/mnt/media /var/mnt/media/riven /var/mnt/media/zurg; do
  findmnt -rn -o TARGET,FSTYPE,PROPAGATION "$m" || echo "$m not mounted"
done
echo; echo "image:"; bootc status --format=humanreadable 2>/dev/null | sed -n '1,8p' || true
