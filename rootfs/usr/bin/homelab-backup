#!/usr/bin/bash
# Nightly restic backup: Postgres dump + app state + /etc/homelab.
# Skips what's re-creatable: Jellyfin cache, raw DB/Redis files, Ollama models.
set -euo pipefail
set -a; . /etc/homelab/homelab.env; . /etc/homelab/secrets.env; set +a
: "${RESTIC_REPOSITORY:?set RESTIC_REPOSITORY in secrets.env}"
: "${RESTIC_PASSWORD:?set RESTIC_PASSWORD in secrets.env}"
# A bare word is a relative path to restic, and `restic init` would try to create it under read-only /.
case "$RESTIC_REPOSITORY" in
  /* | *:*) ;;
  *) echo "RESTIC_REPOSITORY=$RESTIC_REPOSITORY is not an absolute path or backend URL" >&2; exit 1 ;;
esac

APP=/var/lib/homelab/appdata
restic cat config >/dev/null 2>&1 || restic init

echo "dumping riven-db"
podman exec riven-db pg_dump -U riven --clean --if-exists --no-owner riven >"$APP/_dumps/riven.sql.tmp"
mv "$APP/_dumps/riven.sql.tmp" "$APP/_dumps/riven.sql"

echo "dumping paperless-db"
podman exec paperless-db pg_dump -U paperless --clean --if-exists --no-owner paperless >"$APP/_dumps/paperless.sql.tmp"
mv "$APP/_dumps/paperless.sql.tmp" "$APP/_dumps/paperless.sql"

# SQLite apps: stop briefly for a consistent copy, always restart.
SQLITE_APPS=(seerr jellyfin open-webui paperless-gpt)
restart() { systemctl start "${SQLITE_APPS[@]/%/.service}" || true; }
trap restart EXIT
systemctl stop "${SQLITE_APPS[@]/%/.service}"

restic backup --tag homelab --host "${TS_HOSTNAME:-homelab}" \
  /etc/homelab "$APP" \
  --exclude "$APP/jellyfin/cache" \
  --exclude "$APP/riven/db" \
  --exclude "$APP/riven/redis" \
  --exclude "$APP/paperless/db" \
  --exclude "$APP/paperless/redis" \
  --exclude "$APP/ollama" \
  --exclude "$APP/riven/logs"

restart; trap - EXIT
restic forget --tag homelab --keep-daily 7 --keep-weekly 4 --keep-monthly 6 --prune
restic check --read-data-subset=2% || echo "WARNING: restic check reported problems"
