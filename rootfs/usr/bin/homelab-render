#!/usr/bin/bash
# Renders the config that can't be static because it embeds a secret: riven.env
# (DB password), zurg's config.yml (RD token), the cf_api_token and riven_db_pw
# podman secrets, and the tailnet join. Everything else ships in the image.
# Idempotent: runs every boot, safe to re-run by hand (then restart services).
set -euo pipefail

ETC=/etc/homelab
SHARE=/usr/share/homelab
CFG=/var/lib/homelab/config

log() { echo "homelab-render: $*"; }
die() { echo "homelab-render: ERROR: $*" >&2; exit 1; }

[[ -r $ETC/homelab.env ]] || die "missing $ETC/homelab.env (copy from $SHARE/examples/)"
[[ -r $ETC/secrets.env ]] || die "missing $ETC/secrets.env (copy from $SHARE/examples/)"
[[ $(stat -c %a "$ETC/secrets.env") == 600 ]] || { chmod 600 "$ETC/secrets.env"; log "fixed secrets.env mode to 600"; }

set -a
# shellcheck source=/dev/null
. "$ETC/homelab.env"
# shellcheck source=/dev/null
. "$ETC/secrets.env"
set +a

# DOMAIN/LAN_IP/ACME_EMAIL are unused below, but this runs before the
# containers, so it's where a half-filled config gets caught.
for v in DOMAIN LAN_IP ACME_EMAIL CF_API_TOKEN RD_TOKEN TMDB_API_KEY RIVEN_DB_PASSWORD PAPERLESS_DB_PASSWORD PAPERLESS_SECRET_KEY; do
  [[ -n ${!v:-} ]] || die "$v is not set in $ETC/{homelab,secrets}.env"
done
# Filled in after first boot (generated inside the Seerr / Jellyfin UIs).
SEERR_API_KEY=${SEERR_API_KEY:-}
JELLYFIN_API_KEY=${JELLYFIN_API_KEY:-}
RIVEN_PLUGINS=${RIVEN_PLUGINS:-[\"seerr\",\"stremthru\",\"torrentio\",\"comet\",\"jellyfin\"]}
export SEERR_API_KEY JELLYFIN_API_KEY RIVEN_PLUGINS

# Explicit variable list, so a stray $ in a template survives envsubst.
VARS='${RD_TOKEN} ${TMDB_API_KEY} ${RIVEN_DB_PASSWORD} ${SEERR_API_KEY} ${JELLYFIN_API_KEY} ${RIVEN_PLUGINS}'
render() { # template dest mode
  local tmp; tmp=$(mktemp)
  envsubst "$VARS" <"$SHARE/templates/$1" >"$tmp"
  install -m "$3" "$tmp" "$2"; rm -f "$tmp"
}
render zurg-config.yml  "$CFG/zurg/config.yml"   0600
render riven.env        "$CFG/riven/riven.env"   0600

# Extra plugin settings (e.g. Comet), appended verbatim.
if [[ -r $ETC/riven.extra.env ]]; then
  cat "$ETC/riven.extra.env" >>"$CFG/riven/riven.env"
fi
[[ -n $SEERR_API_KEY && -n $JELLYFIN_API_KEY ]] || \
  log "NOTE: SEERR_API_KEY / JELLYFIN_API_KEY empty: Riven won't see requests until you add them (docs/first-boot.md)"

printf %s "$CF_API_TOKEN"          | podman secret create --replace cf_api_token - >/dev/null
printf %s "$RIVEN_DB_PASSWORD"     | podman secret create --replace riven_db_pw - >/dev/null
printf %s "$PAPERLESS_DB_PASSWORD" | podman secret create --replace paperless_db_pw - >/dev/null
printf %s "$PAPERLESS_SECRET_KEY"  | podman secret create --replace paperless_secret_key - >/dev/null

# Subnet routing needs ip_forward, set by sysctl.d/99-tailscale.conf.
if [[ -n ${TS_AUTHKEY:-} ]] && command -v tailscale >/dev/null; then
  if ! tailscale status >/dev/null 2>&1; then
    log "joining tailnet"
    tailscale up --authkey="$TS_AUTHKEY" --hostname="${TS_HOSTNAME:-homelab}" \
      ${TS_ADVERTISE_ROUTES:+--advertise-routes="$TS_ADVERTISE_ROUTES"} || log "tailscale up failed (non-fatal)"
  fi
fi

log "done"
