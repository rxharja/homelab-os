#!/usr/bin/bash
# Renders the config that can't be static because it embeds a secret or DOMAIN:
# riven.env (DB password), zurg's config.yml (RD token), paperless-gpt.env (API
# token), pocket-id.env (APP_URL), open-webui.env and tinyauth.env (OIDC clients), caddy's
# id.DOMAIN network alias, the cf_api_token, riven_db_pw, pocket_id_encryption_key
# and actual_password podman secrets, and the tailnet join. Everything else ships
# in the image.
# Idempotent: runs every boot, safe to re-run by hand (then restart services).
set -euo pipefail

ETC=/etc/homelab
SHARE=/usr/share/homelab
CFG=/var/lib/homelab/config

log() { echo "homelab-render: $*"; }
die() { echo "homelab-render: ERROR: $*" >&2; exit 1; }

[[ -r $ETC/homelab.env ]] || die "missing $ETC/homelab.env (copy from $SHARE/examples/)"
[[ -r $ETC/secrets.env ]] || die "missing $ETC/secrets.env (copy from $SHARE/examples/)"
[[ $(stat -c %a "$ETC/secrets.env") == 600 ]] || { chmod 600 "$ETC/secrets.env"; log "fixed secrets.env mode to 600"; }

set -a
# shellcheck source=/dev/null
. "$ETC/homelab.env"
# shellcheck source=/dev/null
. "$ETC/secrets.env"
set +a

# DOMAIN/LAN_IP/ACME_EMAIL are unused below, but this runs before the
# containers, so it's where a half-filled config gets caught.
for v in DOMAIN LAN_IP ACME_EMAIL CF_API_TOKEN RD_TOKEN TMDB_API_KEY RIVEN_DB_PASSWORD PAPERLESS_DB_PASSWORD PAPERLESS_SECRET_KEY POCKET_ID_ENCRYPTION_KEY; do
  [[ -n ${!v:-} ]] || die "$v is not set in $ETC/{homelab,secrets}.env"
done

[[ $ACME_EMAIL != *@example.com ]] || die "ACME_EMAIL is still the example address; Let's Encrypt rejects it"

# Filled in after first boot (generated inside the Seerr / Jellyfin UIs).
SEERR_API_KEY=${SEERR_API_KEY:-}
JELLYFIN_API_KEY=${JELLYFIN_API_KEY:-}
PAPERLESS_API_TOKEN=${PAPERLESS_API_TOKEN:-}
PAPERLESS_URL=${PAPERLESS_URL:-}
OPEN_WEBUI_OIDC_CLIENT_ID=${OPEN_WEBUI_OIDC_CLIENT_ID:-}
OPEN_WEBUI_OIDC_CLIENT_SECRET=${OPEN_WEBUI_OIDC_CLIENT_SECRET:-}
TINYAUTH_OIDC_CLIENT_ID=${TINYAUTH_OIDC_CLIENT_ID:-}
TINYAUTH_OIDC_CLIENT_SECRET=${TINYAUTH_OIDC_CLIENT_SECRET:-}
RIVEN_PLUGINS=${RIVEN_PLUGINS:-[\"seerr\",\"stremthru\",\"torrentio\",\"comet\",\"jellyfin\"]}
export SEERR_API_KEY JELLYFIN_API_KEY PAPERLESS_API_TOKEN PAPERLESS_URL OPEN_WEBUI_OIDC_CLIENT_ID OPEN_WEBUI_OIDC_CLIENT_SECRET TINYAUTH_OIDC_CLIENT_ID TINYAUTH_OIDC_CLIENT_SECRET RIVEN_PLUGINS

# Explicit variable list, so a stray $ in a template survives envsubst.
VARS='${RD_TOKEN} ${TMDB_API_KEY} ${RIVEN_DB_PASSWORD} ${SEERR_API_KEY} ${JELLYFIN_API_KEY} ${PAPERLESS_API_TOKEN} ${PAPERLESS_URL} ${RIVEN_PLUGINS} ${DOMAIN} ${OPEN_WEBUI_OIDC_CLIENT_ID} ${OPEN_WEBUI_OIDC_CLIENT_SECRET} ${TINYAUTH_OIDC_CLIENT_ID} ${TINYAUTH_OIDC_CLIENT_SECRET}'
render() { # template dest mode
  local tmp; tmp=$(mktemp)
  envsubst "$VARS" <"$SHARE/templates/$1" >"$tmp"
  install -m "$3" "$tmp" "$2"; rm -f "$tmp"
}
render zurg-config.yml  "$CFG/zurg/config.yml"   0600
render riven.env        "$CFG/riven/riven.env"   0600
render paperless-gpt.env "$CFG/paperless-gpt/paperless-gpt.env" 0600
render pocket-id.env    "$CFG/pocket-id/pocket-id.env"   0600
render open-webui.env   "$CFG/open-webui/open-webui.env" 0600
render tinyauth.env     "$CFG/tinyauth/tinyauth.env"     0600

# Quadlet drop-in, so the generator must re-run before caddy starts (it is ordered after us).
ALIAS=/run/containers/systemd/caddy.container.d/50-alias.conf
old=$(cat "$ALIAS" 2>/dev/null || true)
mkdir -p "${ALIAS%/*}"
render caddy-alias.conf "$ALIAS" 0644
[[ $(cat "$ALIAS") == "$old" ]] || systemctl daemon-reload

# Extra plugin settings (e.g. Comet), appended verbatim.
if [[ -r $ETC/riven.extra.env ]]; then
  cat "$ETC/riven.extra.env" >>"$CFG/riven/riven.env"
fi
[[ -n $SEERR_API_KEY && -n $JELLYFIN_API_KEY ]] || \
  log "NOTE: SEERR_API_KEY / JELLYFIN_API_KEY empty: Riven won't see requests until you add them (docs/first-boot.md)"
[[ -n $TINYAUTH_OIDC_CLIENT_ID ]] || \
  log "NOTE: TINYAUTH_OIDC_CLIENT_ID empty: sort.DOMAIN and adguard.DOMAIN stay locked until you add it (docs/first-boot.md)"
[[ -n $PAPERLESS_API_TOKEN ]] || \
  log "NOTE: PAPERLESS_API_TOKEN empty: paperless-gpt can't reach Paperless until you add it (docs/first-boot.md)"

printf %s "$CF_API_TOKEN"          | podman secret create --replace cf_api_token - >/dev/null
printf %s "$RIVEN_DB_PASSWORD"     | podman secret create --replace riven_db_pw - >/dev/null
printf %s "$PAPERLESS_DB_PASSWORD" | podman secret create --replace paperless_db_pw - >/dev/null
printf %s "$PAPERLESS_SECRET_KEY"  | podman secret create --replace paperless_secret_key - >/dev/null
printf %s "$POCKET_ID_ENCRYPTION_KEY" | podman secret create --replace pocket_id_encryption_key - >/dev/null
# Optional: only actual-ai uses it, and podman refuses an empty secret.
if [[ -n ${ACTUAL_PASSWORD:-} ]]; then
  printf %s "$ACTUAL_PASSWORD" | podman secret create --replace actual_password - >/dev/null
elif [[ -e $ETC/actual-ai.env ]]; then
  log "NOTE: ACTUAL_PASSWORD empty: actual-ai won't start until you add it (docs/first-boot.md)"
fi

# Subnet routing needs ip_forward, set by sysctl.d/99-tailscale.conf.
if [[ -n ${TS_AUTHKEY:-} ]] && command -v tailscale >/dev/null; then
  if ! tailscale status >/dev/null 2>&1; then
    log "joining tailnet"
    tailscale up --authkey="$TS_AUTHKEY" --hostname="${TS_HOSTNAME:-homelab}" \
      ${TS_ADVERTISE_ROUTES:+--advertise-routes="$TS_ADVERTISE_ROUTES"} || log "tailscale up failed (non-fatal)"
  fi
fi

log "done"
