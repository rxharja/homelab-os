[Unit]
Description=Redis for Riven

[Container]
Image=docker.io/library/redis:8-alpine
AutoUpdate=registry
ContainerName=riven-redis
Network=homelab.network
UserNS=auto
Exec=redis-server --maxmemory-policy noeviction --appendonly yes
Volume=/var/lib/homelab/appdata/riven/redis:/data:Z,U
HealthCmd=redis-cli ping
HealthInterval=10s
Notify=healthy

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
