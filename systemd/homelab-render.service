[Unit]
Description=Render homelab config from /etc/homelab into /var/lib/homelab
Wants=network-online.target
After=network-online.target firewalld.service tailscaled.service
Before=adguard.service caddy.service zurg.service riven-db.service riven.service seerr.service open-webui.service ollama.service
ConditionPathExists=/etc/homelab/homelab.env

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/homelab-render

[Install]
WantedBy=multi-user.target
